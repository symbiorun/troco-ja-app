# =============================================================================
# TROCO JÁ — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais
# NUNCA commite o .env.local no Git
# =============================================================================

# ── Supabase (Banco Exclusivo) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TrocoJá

# ── Backend API (Express legado — migrar para Next.js API Routes) ────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Asaas (Pagamentos Online) ─────────────────────────────────────────────────
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=sua-api-key-asaas
ASAAS_WEBHOOK_TOKEN=token-secreto-para-verificar-webhooks

# ── Mercado Pago (Maquininha presencial — config via Admin Panel) ─────────────
# Taxas configuradas em admin_configs no Supabase
# Não é necessário API key aqui pois a maquininha é operada pelo operador fisicamente

# ── Resend (E-mail transacional) ──────────────────────────────────────────────
RESEND_API_KEY=sua-api-key-resend
RESEND_FROM_EMAIL=noreply@trocoja.com.br

# ── Z-API (WhatsApp) ─────────────────────────────────────────────────────────
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=seu-instance-id
ZAPI_TOKEN=seu-token-zapi
ZAPI_CLIENT_TOKEN=seu-client-token
ZAPI_WEBHOOK_TOKEN=token-secreto-para-verificar-webhook-zapi

# ── OpenRouter (IA — Agentes KYC, Risco, WhatsApp, Copilot) ──────────────────
# Cadastre em: https://openrouter.ai
# Modelos usados:
#   KYC:            google/gemini-2.5-pro-preview       (~$1.25/M tokens input)
#   Risk:           anthropic/claude-sonnet-4            (~$3.00/M tokens input)
#   WhatsApp:       google/gemini-2.5-flash-preview      (~$0.15/M tokens input)
#   Staff Copilot:  google/gemini-2.5-flash-preview      (~$0.15/M tokens input)
OPENROUTER_API_KEY=sk-or-sua-api-key-openrouter

# ── Dados da Operadora (usados no contrato) ───────────────────────────────────
OPERADORA_NOME=TrocoJá Serviços Financeiros LTDA
OPERADORA_CNPJ=00.000.000/0001-00
OPERADORA_CIDADE=São Paulo
OPERADORA_ESTADO=SP

# ── Google OAuth (configurar no Supabase Dashboard > Auth > Providers) ────────
# Google: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET são configurados NO Supabase, não aqui

# ── Cloudflare Turnstile (anti-bot) ───────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua-site-key
TURNSTILE_SECRET_KEY=sua-secret-key

# ── FingerprintJS (device intelligence) ──────────────────────────────────────
NEXT_PUBLIC_FINGERPRINT_API_KEY=sua-fingerprint-key

# ── Analytics (opcional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=sua-posthog-key
